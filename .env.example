# Local setup: supply your own key and a unique administrator password.
OPENAI_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ALLOW_SIGNUP=false

# Optional Azure OpenAI. Presets use public model IDs, not private deployment names.
# FOUNDRY_RESOURCE=your-resource
# FOUNDRY_API_KEY=
# Verify each deployment serves the named OpenAI model before configuring it.
# FOUNDRY_DEPLOYMENT_MAP='{"gpt-5.6-sol":"your-deployment"}'

# Optional OpenRouter: only approved openai/ model IDs are allowed.
# OPENROUTER_API_KEY=

# Provider endpoints and models are allowlisted; custom/local proxies are disabled.
# Private presets may be kept in the ignored council.local.json file.
# COUNCIL_CONFIG=council.local.json
# EXTRA_MODELS=openai:gpt-4.1-mini,openrouter:openai/gpt-5.1
# REPLACEMENT_PROVIDER=foundry-openai
# REPLACEMENT_MODEL=gpt-6-astra
# REQUEST_TIMEOUT=360
# MAX_OUTPUT_TOKENS=8192
# SESSION_DAYS=30
# HOST=127.0.0.1
# PORT=8001
# DB_PATH=data/council.db
# SQLITE_JOURNAL_MODE=WAL   # Use DELETE on network filesystems without WAL support.
